# Copy to .env and fill in. Never commit .env.

# Google Maps — the Maps Demo Key can go in BOTH lines while prototyping.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_ROUTES_SERVER_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID

# Optional live feeds (the app runs without them; /api/alerts shows feed health)
# 511NY developer key (free): https://511ny.org/developers
NY511_API_KEY=
# MTA API key, only if the MTA feeds ask for one: https://api.mta.info
MTA_API_KEY=

PORT=3000

# Screenshot reading for community reports (optional; without it, reporters pick the type)
# https://platform.claude.com — the image is sent for reading and never stored
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# sim = demo with a movable parade clock; live = the real day (clock locked to real time)
CLOCK_MODE=sim
# Protects POST /api/parade/position (live parade-position reports from your team)
OPERATOR_TOKEN=
# Keep reports across restarts (single instance)
REPORTS_FILE=
